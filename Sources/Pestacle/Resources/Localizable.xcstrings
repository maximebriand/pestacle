          }
        }
      }
    },
    "Spectacle and Pestacle use the same shortcuts, so only one of them can respond. Quit Spectacle so that Pestacle can take over?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectacle et Pestacle utilisent les mêmes raccourcis : un seul des deux peut y répondre. Quitter Spectacle pour que Pestacle prenne le relais ?"
          }
        }
      }
    },
    "Spectacle is running" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectacle est ouvert"
          }
        }
      }
    },
    "Spectacle shortcuts imported" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcis de Spectacle importés"
          }
        }
      }
    },
    "Spectacle's shortcuts file could not be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de raccourcis de Spectacle n'a pas pu être lu."
          }
        }
      }
    },
    "This shortcut is reserved by macOS. You can change it in System Settings › Keyboard › Keyboard Shortcuts." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce raccourci est réservé par macOS. Vous pouvez le modifier dans Réglages Système › Clavier › Raccourcis clavier."
          }
        }
      }
    },
    "To move and resize the windows of other apps, Pestacle uses the macOS Accessibility features. Pestacle only changes window positions and sizes; it does not read their contents." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour déplacer et redimensionner les fenêtres des autres apps, Pestacle utilise les fonctions d'accessibilité de macOS. Pestacle ne modifie que la position et la taille des fenêtres ; il ne lit pas leur contenu."
          }
        }
      }
    },
    "Top Half" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moitié haute"
          }
        }
      }
    },
